# Copy to .env (gitignored) and set to true to show the review panel (🧾 icon
# in the header) — the card-tagging workflow tool, not meant for a deployed/
# public copy of the app. Leave unset (or omit the file) on a server deployment.
NUXT_PUBLIC_ENABLE_REVIEW=true

# Only needed if the repo lives on /mnt/c under WSL (or any other setup where
# inotify doesn't reliably fire for file changes) — without this, editing a
# server/api/*.ts file silently keeps serving the OLD handler until you
# manually restart `npm run dev` (confirmed: Nuxt's own Vite-side polling
# config in nuxt.config.ts isn't enough on its own; Nitro's server-bundle
# watcher is a separate chokidar instance that only honors this env var, not
# nitro's own `watchOptions` config key — see nuxt.config.ts's own comment).
# Leave unset on a normal native filesystem (macOS/Linux/native Windows) —
# polling costs real CPU for no benefit there.
# CHOKIDAR_USEPOLLING=true
# CHOKIDAR_INTERVAL=300
